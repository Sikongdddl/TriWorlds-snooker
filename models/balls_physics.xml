<mujoco>
  <worldbody>
    <body name="cue_ball" pos="0 -0.616 1.0785">
      <freejoint name="cue_ball_free"/>
      <!-- Same cue-ball construction as the source one-ball.xml/nine-ball.xml:
           the source ball class plus six red rotation markers. -->
      <geom name="cue_ball_geom" class="ball" pos="0 0 0" rgba="1 1 1 1"/>
      <site name="cue_ball_marker_pos_x" type="cylinder" size="0.004 0.001"
            rgba="1 0 0 1" pos="0.0275 0 0" zaxis="1 0 0"/>
      <site name="cue_ball_marker_neg_x" type="cylinder" size="0.004 0.001"
            rgba="1 0 0 1" pos="-0.0275 0 0" zaxis="1 0 0"/>
      <site name="cue_ball_marker_pos_y" type="cylinder" size="0.004 0.001"
            rgba="1 0 0 1" pos="0 0.0275 0" zaxis="0 1 0"/>
      <site name="cue_ball_marker_neg_y" type="cylinder" size="0.004 0.001"
            rgba="1 0 0 1" pos="0 -0.0275 0" zaxis="0 1 0"/>
      <site name="cue_ball_marker_pos_z" type="cylinder" size="0.004 0.001"
            rgba="1 0 0 1" pos="0 0 0.0275"/>
      <site name="cue_ball_marker_neg_z" type="cylinder" size="0.004 0.001"
            rgba="1 0 0 1" pos="0 0 -0.0275"/>
    </body>

    <!-- Fifteen-ball rack. Adjacent centers are 58 mm apart, matching the
         source scenarios and leaving a 1 mm initialization clearance. -->
