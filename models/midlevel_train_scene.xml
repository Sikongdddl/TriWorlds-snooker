<mujoco model="midlevel_cue_ball_training_scene">
  <compiler angle="radian" coordinate="local" autolimits="true"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="RK4"
          solver="Newton" iterations="80" tolerance="1e-8"/>

  <visual>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.8 0.8 0.8" specular="0.25 0.25 0.25"/>
  </visual>

  <worldbody>
    <light name="midlevel_key_light" pos="0 -2.0 2.5" dir="0 0 -1" diffuse="0.9 0.9 0.86"/>
    <camera name="midlevel_overview" pos="0 -2.4 1.5" xyaxes="1 0 0 0 0.55 0.84"/>
  </worldbody>

  <include file="pool_table_asset.xml"/>
  <include file="table_physics.xml"/>
  <include file="midlevel_balls.xml"/>
  <include file="cue_physics.xml"/>
</mujoco>
