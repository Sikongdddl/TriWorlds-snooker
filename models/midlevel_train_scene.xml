<mujoco model="mujoco_billiards_midlevel_training_scene">
  <include file="../../mujoco-billiards/ball-definitions.xml"/>
  <compiler angle="degree" coordinate="local" autolimits="true"
            meshdir="."
            texturedir="../../mujoco-billiards/img"/>
  <option timestep="0.00002" gravity="0 0 -9.81" integrator="Euler"
          solver="Newton" iterations="80" tolerance="1e-8"/>
  <visual>
    <global offheight="720" offwidth="720"/>
  </visual>
  <worldbody>
    <camera name="cam1" pos="0 -2.0 2.5" euler="45 0 0"/>
    <camera name="cam2" pos="0 0 4.3"/>
  </worldbody>
  <include file="mujoco_billiards/billiard-table-definitions.xml"/>
  <include file="mujoco_billiards_integration.xml"/>
  <include file="midlevel_balls.xml"/>
  <include file="cue_physics.xml"/>
</mujoco>
