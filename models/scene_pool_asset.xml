<mujoco model="mujoco_billiards_robot_scene">
  <!-- Load the reusable ball class, textures, and materials directly from the
       source repository. The compiler override resolves those source textures
       while keeping this repository's robot and cue meshes resolvable. -->
  <include file="../../mujoco-billiards/ball-definitions.xml"/>
  <compiler angle="degree" coordinate="local" autolimits="true"
            meshdir="."
            texturedir="../../mujoco-billiards/img"/>
  <!-- Use a practical interactive step while retaining the source contact
       geometry and material parameters. -->
  <option timestep="0.00001" gravity="0 0 -9.81" integrator="Euler"
          solver="Newton" iterations="80" tolerance="1e-8"/>
  <visual>
    <global offheight="720" offwidth="720"/>
  </visual>
  <worldbody>
    <!-- Cameras copied from mujoco-billiards/nine-ball.xml. -->
    <camera name="cam1" pos="0 -2.0 2.5" euler="45 0 0"/>
    <camera name="cam2" pos="0 0 4.3"/>
  </worldbody>
  <include file="mujoco_billiards/billiard-table-definitions.xml"/>
  <include file="mujoco_billiards_integration.xml"/>
  <include file="balls_physics.xml"/>
  <include file="cue_physics.xml"/>
  <include file="lift_articulated.xml"/>
  <include file="grip_constraints.xml"/>
</mujoco>
