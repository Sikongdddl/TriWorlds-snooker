<mujoco>
  <asset>
    <material name="gento_cue_wood_mat" rgba="0.72 0.43 0.20 1"/>
    <material name="gento_cue_tip_mat" rgba="0.03 0.03 0.028 1"/>
    <texture name="gento_cue_texture" type="2d"
             file="../assets/cue/sketchfab_pool_table_traditional/cue_mat_baseColor.png"/>
    <material name="gento_cue_visual_mat" texture="gento_cue_texture"
              rgba="1 1 1 1" reflectance="0.08"/>
    <mesh name="gento_cue_visual"
          file="../assets/cue/sketchfab_pool_table_traditional/pool_cue_visual_local.obj"/>
  </asset>

  <worldbody>
    <!-- The shaft center is 11 mm above the 1.090 m rail top. Its 10 mm
         radius therefore leaves a real 1 mm clearance over the cushion. -->
    <body name="cue_body" pos="0 -1.3996 1.101"
          quat="0.7071067812 0 0 0.7071067812">
      <freejoint name="cue_free"/>
      <geom name="cue_visual_mesh" type="mesh" mesh="gento_cue_visual"
            material="gento_cue_visual_mat" contype="0" conaffinity="0"
            density="0"/>
      <!-- Bit 32 contacts the finger pads (bit 64); affinity bit 1 also makes
           the shaft collide with the source table's real SDF/wood geoms. -->
      <geom name="cue_shaft" type="capsule" fromto="-0.725 0 0 0.705 0 0"
            size="0.010" mass="0.50" material="gento_cue_wood_mat"
            contype="32" conaffinity="65" condim="4" priority="3"
            friction="0.12 0.002 0.0002" solref="0.003 1"
            solimp="0.92 0.99 0.001"/>
      <geom name="cue_tip" type="capsule" fromto="0.705 0 0 0.725 0 0"
            size="0.009" mass="0.03" material="gento_cue_tip_mat"
            contype="4" conaffinity="3" condim="6" priority="4"
            friction="0.35 0.008 0.0001" solref="-5e6 -300"
            solimp="0.95 0.99 0.001"/>
      <site name="cue_tip_site" pos="0.725 0 0" size="0.006" rgba="0 1 0 1"/>
      <site name="cue_axis_site" pos="0 0 0" size="0.004" rgba="0 0.4 1 1"/>
      <site name="cue_bridge_site" pos="0.650 0 0" size="0.015"
            rgba="0.15 1 0.35 1"/>
      <site name="cue_left_grip_site" pos="0.150333 0 0" size="0.015"
            rgba="0.1 0.8 1 1"/>
      <site name="cue_right_grip_site" pos="-0.349667 0 0" size="0.015"
            rgba="1 0.35 0.1 1"/>
      <site name="cue_back_site" pos="-0.725 0 0" size="0.010"
            rgba="1 1 0 1"/>
    </body>
  </worldbody>
</mujoco>
