<mujoco>
  <asset>
    <material name="dynamic_cue_wood_mat" rgba="0.72 0.43 0.20 1"/>
    <material name="dynamic_cue_tip_mat" rgba="0.03 0.03 0.028 1"/>
    <texture name="sketchfab_cue_texture" type="2d" file="../../TriWorlds-snooker/assets/cue/sketchfab_pool_table_traditional/cue_mat_baseColor.png"/>
